// ここに JavaScript を書いてください。index.html からはすでに読み込まれています。
//
// ※ ページは必ず VSCode の Live Server で開くこと。
//    ファイルを直接開くと data.json を読み込めません。
// ※ 仕様書はFigmaにあります： https://www.figma.com/design/pamOd8ehnMa1bfpVjw1Yvw/?node-id=0-1
//
// 使える目印
//   #cafe-list      … カード（<li>）を入れる場所
//   #cafe-tabs      … タブ4つ。各ボタンに data-category（all / specialty / roast / sweets）
//   #contact-form   … お問い合わせフォーム
//   #name-error     … お名前のエラーメッセージを入れる場所
//
// カフェのデータは同じフォルダの data.json にあります。
// DOMの読み込み完了後に実行
document.addEventListener('DOMContentLoaded', () => {
  // カフェデータを取得して表示するメイン関数
  fetchCafeData();
});

/**
 * data.jsonからデータを取得する関数
 */
async function fetchCafeData() {
  try {
    // 1. data.json の読み込み
    const response = await fetch('data.json');
    if (!response.ok) {
      throw new Error('データの取得に失敗しました');
    }
    
    // 2. JSONデータのパース
    const data = await response.json();
    
    // 3. カードの生成・レンダリング
    renderCafeCards(data);
  } catch (error) {
    console.error('エラー:', error);
  }
}

/**
 * カフェのカード一覧を画面に描画する関数
 * @param {Array} cafes - カフェデータの配列
 */
function renderCafeCards(cafes) {
  // TODO: 仕様書に合わせて、カードを挿入する親要素のセレクタを変更してください
  const container = document.querySelector('.cafe-list-container') || document.querySelector('main');
  
  if (!container) return;

  // コンテナを一度空にする（必要に応じて）
  container.innerHTML = '';

  // データの配列をループ処理してHTMLを生成
  cafes.forEach(cafe => {
    // カードのルート要素を作成
    const card = document.createElement('div');
    card.classList.add('cafe-card'); // 仕様書のクラス名に合わせて変更

    // TODO: JSONのキー名（name, image, desc等）は仕様書やdata.jsonの中身を確認して一致させてください
    card.innerHTML = `
      <div class="cafe-card__image">
        <img src="images/${cafe.image}" alt="${cafe.name}">
      </div>
      <div class="cafe-card__content">
        <h3 class="cafe-card__title">${cafe.name}</h3>
        <p class="cafe-card__description">${cafe.description || cafe.desc || ''}</p>
        ${cafe.tags ? `<p class="cafe-card__tags">${cafe.tags.join(', ')}</p>` : ''}
      </div>
    `;

    // 親要素に追加
    container.appendChild(card);
  });
}
